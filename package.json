{
  "name": "appflow-explorer",
  "private": true,
  "version": "0.1.0",
  "description": "Visual, interactive map of a mobile app's screens, navigation and source code.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @appflow/desktop",
    "build": "npm run build -w @appflow/desktop",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
